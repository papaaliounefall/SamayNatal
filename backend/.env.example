# Copy to .env and fill in real values. Never commit the real .env file.

# --- Django core -------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_LOG_LEVEL=INFO

# --- Database (docker-compose service name in dev: "db") ---------------
DATABASE_URL=postgres://samay_natal:samay_natal@localhost:5432/samay_natal

# --- Redis / Celery ------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible; MinIO in dev) -----------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=samay-natal
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
SIGNED_URL_EXPIRE_SECONDS=600
HD_DOWNLOAD_URL_EXPIRE_SECONDS=900

# --- CORS / frontend -----------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Business rules --------------------------------------------------
PLATFORM_COMMISSION_RATE=0.10
PAYMENT_PROVIDER=MOCK

# --- Auth / lockout ------------------------------------------------------
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15

# --- Email (prod only; console backend used in dev) ----------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@samay-natal.com

# --- Optional: antivirus scanning for uploads (see apps/photos/security.py) --
CLAMAV_HOST=
